# Read at build time (NEXT_PUBLIC_*): set them before `pnpm build`, not only before `pnpm start`
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "false" hides the passkey sign-in; anything else (or unset) offers it where the browser can
NEXT_PUBLIC_PASSKEY_ENABLED=
# Server only. The same value as Core's INTERNAL_HMAC_SECRETS: without it the profile lists cannot be read (§7.7)
INTERNAL_HMAC_SECRETS=
# Never in a production build: it turns on /dev/* (a password sign-in among them) and the motion log
# NEXT_PUBLIC_MOTION_LOG=
